// Gerado automaticamente: fontes e fundos (com logos já aplicados) para os PDFs, sem transparências.
export const LTWaveThin = "";
export const LTWaveLight = "";
export const LTWaveRegular = "";
export const LTWaveMedium = "";
export const LTWaveBold = "";
export const Alisiya = "";
export const LogoPng = "";
export let pdf_dark1 = "";
export let pdf_dark2 = "";
export let pdf_light1 = "";
export let pdf_light2 = "";
export let pdf_light3 = "";
export let pdf_bg_cover = "";
export let pdf_bg_intro = "";
export let pdf_bg_contact = "";
export const pdf_logo_on_white = "";

// Fundos das páginas do PDF: ficam em /_pdf/ (arquivos estáticos) e são carregados uma vez antes de gerar o PDF.
const HEAVY: Record<string, string> = { pdf_dark1: "jpg", pdf_dark2: "jpg", pdf_light1: "jpg", pdf_light2: "jpg", pdf_light3: "jpg", pdf_bg_cover: "jpg", pdf_bg_intro: "jpg", pdf_bg_contact: "jpg" };
let loaded: Promise<void> | null = null;
export function loadPdfImages(origin: string) {
  return (loaded ||= (async () => {
    const got = await Promise.all(Object.entries(HEAVY).map(async ([k, ext]) => [k, Buffer.from(await (await fetch(`${origin}/_pdf/${k}.${ext}`)).arrayBuffer()).toString("base64")] as const));
    for (const [k, v] of got) {
      if (k === "pdf_dark1") pdf_dark1 = v; else if (k === "pdf_dark2") pdf_dark2 = v; else if (k === "pdf_light1") pdf_light1 = v; else if (k === "pdf_light2") pdf_light2 = v;
      else if (k === "pdf_light3") pdf_light3 = v; else if (k === "pdf_bg_cover") pdf_bg_cover = v; else if (k === "pdf_bg_intro") pdf_bg_intro = v; else pdf_bg_contact = v;
    }
  })().catch((x) => { loaded = null; throw x; }));
}
